---
import type { Product } from "@lib/schemas/Product";
import type { HTMLAttributes } from "astro/types";
import ProductOverviewSingle from "./ProductOverviewSingle.astro";
import { Image } from "astro:assets";
import donutImage from "@lib/assets/fredagsmunk-rabarber.jpeg";
import Card from "./Card.astro";

interface Props extends HTMLAttributes<"div"> {
  products: Array<{ product: Product; availablePickupDates: string[] }>;
}

const { products, class: className, ...rest } = Astro.props;
---

<div
  {...rest}
  class:list={["product-overview md:columns-2 lg:columns-3", className]}
>
  {
    products.map(({ product, availablePickupDates }) => (
      <ProductOverviewSingle product={product} {availablePickupDates} />
    ))
  }

  <Card
    padded
    linked
    title="Fredagsmunk"
    description="Ny smak varje vecka"
    stacked
  >
    <Image
      src={donutImage}
      alt="Fredagsmunk med rabarber"
      width={770}
      slot="image"
    />
    <a href="/bestall/fredagsmunk" slot="actions" class="btn btn--small"
      >Läs mer</a
    >
  </Card>
</div>

<style>
  .product-overview {
    column-gap: calc(var(--spacing) * 8);
  }

  .product-overview :global(.card) {
    break-inside: avoid;
    margin-bottom: calc(var(--spacing) * 8);
  }
</style>
