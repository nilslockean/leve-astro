---
import type { HTMLAttributes } from "astro/types";
import { capitalize } from "@lib/stringUtils";
import { formatDate } from "@lib/dateUtils";
import { getDefaultOpeningHours } from "@lib/openingHours";
import { getOpeningHoursForDate } from "@lib/openingHoursUtils";

interface Props extends HTMLAttributes<"fieldset"> {
  availablePickupDates: string[];
  legend?: string;
}

const { availablePickupDates, legend, ...rest } = Astro.props;

const openingHours = await getDefaultOpeningHours();

const hoursMap: Record<string, string> = {};
for (const dateStr of availablePickupDates) {
  const { closed, time } = getOpeningHoursForDate(dateStr, openingHours);
  if (!closed && time) hoursMap[dateStr] = time;
}

const autoSelectedDate =
  availablePickupDates.length === 1 ? availablePickupDates[0] : "";
---

<fieldset {...rest}>
  {legend && <legend>{legend}</legend>}
  <label for="pickupDate">Upphämtningsdatum</label>
  <select id="pickupDate" name="pickupDate" required>
    <option value="" selected={availablePickupDates.length !== 1}>
      {
        availablePickupDates.length === 0
          ? "Inga datum tillgängliga"
          : "Välj datum för upphämtning"
      }
    </option>
    {
      availablePickupDates.map((dateStr, i) => (
        <option
          value={dateStr}
          selected={availablePickupDates.length === 1 && i === 0}
        >
          {formatDate(dateStr, capitalize)}
        </option>
      ))
    }
  </select>
  <small id="pickupDateHint"></small>
</fieldset>

<script is:inline define:vars={{ hoursMap, autoSelectedDate }}>
  const hint = document.getElementById("pickupDateHint");
  const select = document.getElementById("pickupDate");

  function updateHint(dateStr) {
    if (!hint) return;
    hint.textContent =
      dateStr && hoursMap[dateStr] ? `Öppet ${hoursMap[dateStr]}` : "";
  }

  select?.addEventListener("change", (e) => updateHint(e.target.value));
  updateHint(autoSelectedDate);
</script>
